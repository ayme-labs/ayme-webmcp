{
  "name": "@ayme-dev/webmcp",
  "version": "0.1.0",
  "description": "WebMCP core library.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./internal": {
      "types": "./dist/internal.d.mts",
      "import": "./dist/internal.mjs",
      "default": "./dist/internal.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@ayme-dev/eslint-config": "workspace:*",
    "@ayme-dev/playwright-browser": "workspace:*",
    "@ayme-dev/typescript-config": "workspace:*",
    "eslint": "^10.9.1",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@ayme-dev/playwright-browser": "workspace:*",
    "@ayme-dev/structural-observation": "workspace:*",
    "@mcp-b/webmcp-types": "^5.0.1"
  }
}
